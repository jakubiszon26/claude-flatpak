#!/usr/bin/python3
"""Expose host commands inside the sandbox.

Builds a directory of symlinks, one per host command that the sandbox does not
already provide, all pointing at host-exec. The launcher appends the directory
to PATH, so sandbox tools always win. Prints the directory, or nothing when the
app may not talk to org.freedesktop.Flatpak (for example after a
`flatpak override --no-talk-name=org.freedesktop.Flatpak`).
"""
import os
import subprocess
import sys

HOST_EXEC = "/app/libexec/claude-flatpak/host-exec"
HOST_DIRS = ("/run/host/usr/local/bin", "/run/host/usr/bin")
SANDBOX_DIRS = ("/app/bin", "/usr/bin")


def host_available():
    try:
        return subprocess.run(
            ["flatpak-spawn", "--host", "true"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        ).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def wanted():
    names = set()
    for directory in HOST_DIRS:
        try:
            names.update(os.listdir(directory))
        except OSError:
            continue
    return {
        name for name in names
        if not any(os.path.lexists(os.path.join(d, name)) for d in SANDBOX_DIRS)
    }


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    app_id = os.environ.get("FLATPAK_ID")
    if not runtime_dir or not app_id or not host_available():
        return 0
    target = os.path.join(runtime_dir, "app", app_id, "host-bin")
    os.makedirs(target, mode=0o700, exist_ok=True)
    names = wanted()
    for stale in set(os.listdir(target)) - names:
        os.unlink(os.path.join(target, stale))
    for name in names:
        link = os.path.join(target, name)
        if not os.path.lexists(link):
            os.symlink(HOST_EXEC, link)
    print(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
